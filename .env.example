# Keep the current Netlify URL until your custom domain is purchased and connected.
# After connecting the domain, set this to its HTTPS origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://sketch2svg.netlify.app

# Separate Node.js conversion API. Keep the existing deployed API URL unless it changes.
NEXT_PUBLIC_API_URL=https://svgconverterbackend.onrender.com

# Optional Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_ID=
