# HTTPS origin of the production domain (no trailing slash). Used for sitemap, canonicals and structured data.
NEXT_PUBLIC_SITE_URL=https://graphicconvert.com

# Separate Node.js conversion API. Keep the existing deployed API URL unless it changes.
NEXT_PUBLIC_API_URL=https://svgconverterbackend.onrender.com

# Google Tag Manager container ID. Configure the GA4 measurement ID inside GTM.
NEXT_PUBLIC_GTM_ID=GTM-WVMVHGLD
